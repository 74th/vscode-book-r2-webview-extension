{
  "name": "color-picker",
  "displayName": "color-picker",
  "description": "color picker sample",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.68.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:color-picker.show"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "color-picker.show",
        "title": "show color picker view",
        "category": "Color Picker"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "run-s compile-webview compile-extension",
    "compile-extension": "webpack -c extension.webpack.config.js",
    "compile-webview": "webpack -c webview.webpack.config.js",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.68.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.57.1",
    "glob": "^14.0.6",
    "mocha": "^12.0.3",
    "raw-loader": "^4.0.2",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "npm-run-all2": "^9.0.4"
  },
  "overrides": {
    "minimatch@^10.2.2": "^11.0.8",
    "mocha": {
      "minimatch": "^11.0.8",
      "glob": {
        "minimatch": "^11.0.8"
      }
    }
  }
}
